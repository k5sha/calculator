---
import Layout from "../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const currentLang = getLangFromUrl(Astro.url);
const lang: "en" | "uk" = currentLang === "en" ? "en" : "uk";
const t = useTranslations(lang);

const content = {
  uk: {
    badge: "Error 404 • Page Not Found",
    title: "Сторінку не знайдено",
    description:
      "Здається, цей біт даних було втрачено під час передачі в каналі зв'язку, або сторінку перемістили за іншою адресою.",
    homeBtn: "На головну",
    backBtn: "Назад",
  },
  en: {
    badge: "Error 404 • Page Not Found",
    title: "Page Not Found",
    description:
      "It seems this bit of data was lost in transmission over the noisy channel, or the page has been moved.",
    homeBtn: "Back Home",
    backBtn: "Go Back",
  },
}[lang];

const pageKeywords =
  lang === "uk"
    ? "404, сторінку не знайдено, теорія кодування, кпі"
    : "404, page not found, coding theory lab, error";
---

<Layout
  title={`404 - ${content.title}`}
  description={content.description}
  keywords={pageKeywords}
>
  <div class="error-wrapper">
    <div class="error-container">
      <div class="status-badge">
        <span class="pulse-dot"></span>
        <span class="badge-text">{content.badge}</span>
      </div>

      <h1 class="error-code">
        4<span>0</span>4
      </h1>

      <h2 class="error-title">{content.title}</h2>
      <p class="error-description">{content.description}</p>

      <div class="action-buttons">
        <a href={`/${lang}/`} class="btn btn-primary">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <span>{content.homeBtn}</span>
        </a>

        <button onclick="history.back()" class="btn btn-secondary">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          <span>{content.backBtn}</span>
        </button>
      </div>
    </div>
  </div>
</Layout>

<style>
  .error-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 200px);
    padding: 3rem 1.5rem;
  }

  .error-container {
    max-width: 620px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Статус бейдж */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.2);
    border-radius: 100px;
    margin-bottom: 1.5rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #ef4444;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 6px rgba(239, 68, 68, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
    }
  }

  .badge-text {
    font-size: 0.8rem;
    font-weight: 700;
    color: #dc2626;
  }

  /* Код 404 з градієнтом */
  .error-code {
    font-size: clamp(5rem, 15vw, 8.5rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    margin: 0 0 0.5rem;
    color: var(--text);
  }

  .error-code span {
    background: linear-gradient(135deg, #2563eb 0%, #60a5fa 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    display: inline-block;
  }

  .error-title {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
  }

  .error-description {
    font-size: 1.05rem;
    color: var(--text-light);
    line-height: 1.6;
    margin: 0 0 2.5rem;
    max-width: 500px;
  }

  /* Кнопки дій */
  .action-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    width: 100%;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.8rem 1.6rem;
    border-radius: 100px;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    border: none;
    font-family: inherit;
  }

  .btn-primary {
    background: var(--primary);
    color: white;
  }

  .btn-primary:hover {
    background: var(--primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.25);
  }

  .btn-secondary {
    background: var(--card);
    color: var(--text);
    border: 1px solid var(--border);
  }

  .btn-secondary:hover {
    background: #ffffff;
    border-color: var(--primary);
    color: var(--primary);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
  }

  @media (max-width: 500px) {
    .action-buttons {
      flex-direction: column;
      width: 100%;
    }

    .btn {
      width: 100%;
    }
  }
</style>