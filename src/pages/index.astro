<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <title>Redirecting...</title>

    <script is:inline>
      (function () {
        var userLang = navigator.language || navigator.userLanguage || "";
        var isUkGroup = userLang.startsWith("uk") || userLang.startsWith("be") || userLang.startsWith("ru");
        var target = isUkGroup ? "/uk/" : "/en/";
        window.location.replace(target);
      })();
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/uk/" />
    </noscript>
  </head>
  <body style="display: none; background: #000;">
  </body>
</html>